{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-products": {
        "ClusterId": "catalog",
        "Order": 1,
        "OutputCachePolicy": "catalog-10s",
        "Match": { "Path": "/api/products/{**rest}" }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Order": 1,
        "Match": { "Path": "/api/categories/{**rest}" }
      },
      "basket-api": {
        "ClusterId": "basket",
        "Order": 1,
        "Match": { "Path": "/api/basket/{**rest}" }
      },
      "monolith-basket-ordering": {
        "ClusterId": "monolith",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "d1": { "Address": "http://localhost:5120/" } }
      },
      "basket": {
        "Destinations": { "d1": { "Address": "http://localhost:5130/" } }
      },
      "monolith": {
        "Destinations": { "d1": { "Address": "http://localhost:5110/" } }
      }
    }
  }
}
